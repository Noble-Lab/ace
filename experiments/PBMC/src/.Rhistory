ggplot(vis_umap, aes(x = V1, y = V2)) + geom_point(aes(color = branch), alpha = 0.9, size = 2) +
labs(x = "UMAP1", y = "UMAP2", title = "Trajectory (easy) by branch") + theme(plot.title = element_text(hjust = 0.5)) +
theme(axis.title.x = element_text(size = 20),
axis.title.y = element_text(size= 20),
axis.text.x = element_text(size =15),
axis.text.y = element_text(size = 15))
ggplot(vis_umap, aes(x = V1, y = V2)) + geom_point(aes(color = branch), alpha = 0.6, size = 2) +
labs(x = "UMAP1", y = "UMAP2", title = "Trajectory (easy) by branch") + theme(plot.title = element_text(hjust = 0.5)) +
theme(axis.title.x = element_text(size = 20),
axis.title.y = element_text(size= 20),
axis.text.x = element_text(size =15),
axis.text.y = element_text(size = 15))
ggplot(vis_umap, aes(x = V1, y = V2)) + geom_point(aes(color = pseudotime), alpha = 0.6, size = 2) +
labs(x = "UMAP1", y = "UMAP2", title = "Trajectory (easy) by pseudotime") + theme(plot.title = element_text(hjust = 0.5)) +
scale_color_viridis() +
theme(axis.title.x = element_text(size = 20),
axis.title.y = element_text(size= 20),
axis.text.x = element_text(size =15),
axis.text.y = element_text(size = 15))
ggplot(vis_umap, aes(x = V1, y = V2)) + geom_point(aes(color = branch), alpha = 0.6, size = 2) +
labs(x = "UMAP1", y = "UMAP2", title = "Trajectory (easy) by branch") + theme(plot.title = element_text(hjust = 0.5)) +
theme(axis.title.x = element_text(size = 20),
axis.title.y = element_text(size= 20),
axis.text.x = element_text(size =15),
axis.text.y = element_text(size = 15))
plot(cont_tree, show.tip.label=F)
