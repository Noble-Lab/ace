labs(x = 'UMAP1', y = 'UMAP2', title = 'Leiden clustering') +
theme(legend.title = element_blank())
p2 <- umap %>% ggplot(aes(x = V1, y = V2)) + geom_point(aes(color = as.factor(kmeans_labels)), size = 0.75, alpha = 0.8) +
