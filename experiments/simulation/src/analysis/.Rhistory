library(uwot)
set.seed(4)
umap <- umap(latent_embedding, init = "spectral", verbose = FALSE)
vis_umap = cbind(as.data.frame(umap), "Group" = metadata$cluster)
ggplot(vis_umap, aes(x = V1, y = V2)) + geom_point(aes(color = Group), alpha = 0.6, size = 1) +
scale_color_manual(values = c("#ECA400", "#C81D25", "#00A9A5", "green", "purple"), name = "Group") +
labs(x = "UMAP1", y = "UMAP2") + theme(plot.title = element_text(hjust = 0.5))
