library(tidyverse)
require(cowplot)
theme_set(theme_cowplot())
setwd('~/Desktop/simulation2/src/analysis')
raw_data = read.csv('../../data/220var_clean.csv', header = TRUE, row.names = 1)
metadata = data.frame("unique_id" = rownames(raw_data)) %>% separate(col = "unique_id", into = c("cellid", "cluster"), sep = "_")
true_labels = as.factor(metadata$cluster)
latent_embedding = read.csv('../../results/clean/figs_clean_beta0.01_margin0.5_fd50_latent10/latent_embedding_clean.csv', header = FALSE)
pca = prcomp(latent_embedding, scale. = FALSE)
p1 <- ggplot(data = NULL, aes(x = pca$x[,1], y = pca$x[,2])) + geom_point(aes(color = metadata$cluster), size = 1, alpha = 0.9) +
scale_color_manual(values = c("#ECA400", "#C81D25", "#00A9A5", "green", "purple"), name = "Group") +
labs(x = 'PC1', y = 'PC2')
