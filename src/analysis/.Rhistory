ggplot(vis_umap, aes(x = V1, y = V2)) + geom_point(aes(fill = as.factor(Group)), pch = 21, color = 'black', alpha = 1, size = 2, stroke = 0.5) +
labs(x = "UMAP1", y = "UMAP2", title = "Trajectory (easy)") + theme(plot.title = element_text(hjust = 0.5)) +
theme(axis.title.x = element_text(size = 20),
axis.title.y = element_text(size= 20),
axis.text.x = element_text(size =15),
axis.text.y = element_text(size = 15))
